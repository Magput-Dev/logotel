{
  "name": "magput/logotel",
  "description": "Debug/Tracing hub with OpenTelemetry + MongoDB and Yii2 adapter",
  "type": "library",
  "license": "proprietary",
  "minimum-stability": "stable",
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "ext-redis": "*",
    "psr/log": "^1.1|^2.0|^3.0",
    "open-telemetry/opentelemetry": "^1.0",
    "ramsey/uuid": "^4.2",
    "guzzlehttp/promises": "^2.3",
    "php-http/message-factory": "^1.1",
    "php-http/httplug": "^2.4"
  },
  "autoload": {
    "psr-4": {
      "Magput\\Debug\\": "src/"
    }
  },
  "suggest": {
    "monolog/monolog": "Use Monolog as PSR-3 backend",
    "open-telemetry/opentelemetry-exporter-otlp": "OTLP exporters (gRPC/HTTP)"
  }
}
