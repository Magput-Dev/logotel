{
    "name": "magput/logotel",
    "description": "Shared logging, OpenTelemetry and PSR-15 tracing for Magput APIs, plus Yii2 debug adapter",
    "type": "library",
    "license": "proprietary",
    "version": "1.0.0",
    "minimum-stability": "stable",
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "psr/log": "^1.1|^2.0|^3.0",
        "psr/http-message": "^1.1|^2.0",
        "psr/http-server-middleware": "^1.0",
        "monolog/monolog": "^3.0",
        "fig/http-message-util": "^1.1",
        "ramsey/uuid": "^4.2",
        "open-telemetry/sdk": "^1.15",
        "open-telemetry/exporter-otlp": "^1.4",
        "open-telemetry/opentelemetry-logger-monolog": "^1.2",
        "google/protobuf": "^4.0",
        "guzzlehttp/promises": "^2.3",
        "php-http/message-factory": "^1.1",
        "php-http/httplug": "^2.4",
        "symfony/http-client": "^6.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14"
    },
    "autoload": {
        "psr-4": {
            "Magput\\Debug\\": "src/",
            "Magput\\Logotel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Magput\\Logotel\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "mongodb/mongodb": "Mongo storage for Yii2 debug hub",
        "illuminate/database": "Eloquent Connection::listen() for SQL CLIENT spans"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        },
        "platform": {
            "php": "8.1.31"
        }
    }
}
